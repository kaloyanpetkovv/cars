# Copy to .env and fill in real values. .env is gitignored — never commit it.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...

# Chat/group to notify. For a group, add the bot to it and read the id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after posting a message there.
TELEGRAM_CHAT_ID=-1001234567890

# OpenLane account used for the auto-login fallback
OPENLANE_USERNAME=your_username
OPENLANE_PASSWORD=your_password

# Optional overrides
CHECK_INTERVAL_SECONDS=60
MAX_BURST_NOTIFICATIONS=10
OPENLANE_SEARCH_URL=https://www.openlane.eu/bg/findcar?fuelTypes=100004&auctionTypes=2
