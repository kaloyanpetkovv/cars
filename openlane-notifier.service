[Unit]
Description=OpenLane Telegram notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cars
ExecStart=/home/ubuntu/cars/run.sh
Restart=always
RestartSec=20
OOMScoreAdjust=-500
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
